# Admin credentials (for local development)
# Generate password hash with:
#   node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('your-password', 10).then(h => console.log(Buffer.from(h).toString('base64')))"
# The hash is stored base64-encoded to avoid $-expansion issues in .env files.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=JDJiJDEwJE1MWnpaalE1N0lxWHh2T0IyUFBRemVmYnQ2UXhTaEZURWtLc09hVHhJb2dhcnRYd1poUlc=

# Session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-string

# Site URL (used for SEO metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Turso database (libSQL) — REQUIRED
# For local development without Turso Cloud, use a local SQLite file:
TURSO_DATABASE_URL=file:./bitlog.db
# For remote Turso, create a database at https://turso.tech:
#   turso db create bitlog
#   turso db show bitlog --url        -> the libsql:// URL
#   turso db tokens create bitlog     -> the auth token
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Media dual-write (Turso authoritative store + GitHub/jsdelivr delivery) ──
# Required for image uploads. Generate a fine-grained token at:
#   GitHub → Settings → Developer settings → Fine-grained personal access tokens →
#   Repository access → only zephyr110/blog-img → Permissions → Contents: Read and write
BLOG_IMG_GITHUB_TOKEN=github_pat_xxx
# GitHub repo used as the CDN delivery layer
BLOG_IMG_REPO=zephyr110/blog-img
# Branch of the repo to push to (normal commits only, branch protection safe)
BLOG_IMG_BRANCH=main
# jsdelivr CDN base — swap to fastly.jsdelivr.net / gcore.jsdelivr.net as needed
BLOG_IMG_CDN_BASE=https://cdn.jsdelivr.net/gh/zephyr110/blog-img
# WebP compression quality (1-100, default 80)
BLOG_IMG_QUALITY=80
